programa {
  funcao inicio() {
    real num1, num2, resultado, opcao

    faca{
      escreva("\n Calculadora \n")
      escreva("1 - Soma \n")
      escreva("2 - Subtração \n")
      escreva("3 - Multiplicação \n")
      escreva("4 - Dividir \n")
      escreva("0 - Sair \n")
      escreva("Escolha uma opção")
      leia(opcao)

      limpa()

      

    } enquanto(opcao != 0)


    
  }
}
